# All optional. Defaults shown.
DLH_DB_PATH=deadlink.db
# Add any extra frontend origins. Localhost and the production Vercel site are built in.
DLH_CORS_ORIGINS=
DLH_MAX_CONCURRENT_SCANS=2
# Dev only. NEVER enable on a server reachable by untrusted users (disables SSRF protection).
DLH_ALLOW_PRIVATE_HOSTS=false
